    {
      "type": "attack-flow",
      "spec_version": "2.1",
      "id": "attack-flow--6feae5cc-e91c-525a-8f7f-acf1ab348320",
      "created_by_ref": "identity--9aab5679-38f7-55db-920c-5163cc72b44d",
      "created": "2026-10-22T00:00:00.000Z",
      "modified": "2026-10-22T00:00:00.000Z",
      "name": "php2shell",
      "description": "Web-layer telemetry from a lab exploitation of two PHP runtime bugs, CVE-2026-109618 and CVE-2026-109619, in the pre-RINIT multipart parser of PHP. A single vulnerable endpoint, upload.php, is attacked from one host over about three hours on 2026-10-21. The barrage drives three observable outcomes. First, memory-exhaustion POSTs make the multipart parser fatal before application code runs, logged as \"Allowed memory size ... exhausted ... in Unknown on line 0\" with FPM children exiting code 70. Second, a crafted session plus a session-upload-progress multipart reaches remote command execution through unserialize_callback_func during the pre-RINIT session decode, and the command output (uid=33(www-data)) returns inside a 200 response body, captured in full by an inline proxy. Third, a two-request sequence permanently hangs the Apache mod_php workers, which shows up as \"server reached MaxRequestWorkers\" with no further access-log lines. Four sample logs, correlated: the nginx reverse-proxy access log, the Apache mod_php container log, the vulnerable PHP-FPM pool log, and the inline proxy's full request and response capture. 277 events over roughly three hours (2026-10-21 20:33:46 to 23:22:07 UTC). In this run, the evidence that identified the attack was in the FPM log and the proxy capture, which the default reverse-proxy pipeline we used did not ship.",
      "scope": "incident",
      "start_refs": [
        "attack-action--df42ee79-f963-5db6-8abc-e535eb24f6bd"
      ],
      "external_references": [
        {
          "source_name": "echolake-dataset",
          "description": "php2shell v1.0.0"
        }
      ],
      "extensions": {
        "extension-definition--fb9c968a-745b-4ade-9b25-c324172197f4": {
          "extension_type": "new-sdo"
        }
      }
    },
    {
